  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 9px;
  height: 9px;
  border: 1.5px solid #78828f;
  border-radius: 50%;
}

.search-glyph::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 0;
  width: 5px;
  height: 1.5px;
  background: #78828f;
  transform: rotate(45deg);
  transform-origin: right center;
