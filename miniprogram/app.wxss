/* ---------------- 触控反馈 ---------------- */

.stat-card.linkable,
.quick-item,
.cell,
.row-item,
.snap-row,
.rank-row,
.date-trigger,
.chip,
.rt-tab,
.view-toggle-item,
.group-head,
.cal-cell,
.sheet-close,
.search-clear,
.section-link,
.legend-item,
.refresh-btn {
  transition: transform 0.16s ease, opacity 0.16s ease, background-color 0.16s ease;
}

.stat-card.linkable,
.quick-item,
.cell,
.row-item,
.snap-row,
.rank-row,
.date-trigger,
.rt-tab,
.group-head {
  will-change: transform;
}

.stat-card.linkable:active,
.quick-item:active,
.cell:active,
.row-item:active,
.snap-row:active,
.rank-row:active,
.date-trigger:active,
.rt-tab:active,
.group-head:active {
  transform: scale(0.982);
}

.chip:active {
  transform: scale(0.955);
}

.refresh-btn:active {
  transform: scale(0.9);
}

.cal-cell:active {
  transform: scale(0.9);
}

.section-link:active,
.legend-item:active,
.sheet-close:active,
.search-clear:active {
  opacity: 0.5;
}

/* 所有可点元素：统一过渡 + 页面入场时的渐进出现 */
.tap-item {
  transition: opacity 0.14s ease, transform 0.14s ease, background-color 0.14s ease;
}

.tap-feedback {
  opacity: 0.62;
  transform: scale(0.985);
}

@keyframes tapInA {
  from {
    opacity: 0;
    transform: translateY(4px) scale(0.99);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes tapInB {
  from {
    opacity: 0;
    transform: translateY(4px) scale(0.99);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.page-anim-a .tap-item,
.page-anim-b .tap-item {
  animation: tapInA 0.36s cubic-bezier(0.22, 0.8, 0.3, 1) backwards;
}

.page-anim-b .tap-item {
  animation-name: tapInB;
}

/* 同一组内的按钮依次出现（最多 8 个梯度） */
.page-anim-a .tap-item:nth-child(2),
.page-anim-b .tap-item:nth-child(2) { animation-delay: 0.03s; }
.page-anim-a .tap-item:nth-child(3),
.page-anim-b .tap-item:nth-child(3) { animation-delay: 0.06s; }
.page-anim-a .tap-item:nth-child(4),
.page-anim-b .tap-item:nth-child(4) { animation-delay: 0.09s; }
.page-anim-a .tap-item:nth-child(5),
.page-anim-b .tap-item:nth-child(5) { animation-delay: 0.12s; }
.page-anim-a .tap-item:nth-child(6),
.page-anim-b .tap-item:nth-child(6) { animation-delay: 0.15s; }
.page-anim-a .tap-item:nth-child(7),
.page-anim-b .tap-item:nth-child(7) { animation-delay: 0.18s; }
.page-anim-a .tap-item:nth-child(8),
.page-anim-b .tap-item:nth-child(8) { animation-delay: 0.21s; }
.page-anim-a .tap-item:nth-child(n+9),
.page-anim-b .tap-item:nth-child(n+9) { animation-delay: 0.24s; }

/* 刷新按钮在加载态必须保留旋转动画，不被入场动画覆盖 */
.page-anim-a .refresh-btn.spinning,
.page-anim-b .refresh-btn.spinning {
  animation: spin 0.9s linear infinite;
  animation-delay: 0s;
}

/* 刷新按钮不做入场位移，避免刷新结束后重新“弹”一次 */
.page-anim-a .refresh-btn,
.page-anim-b .refresh-btn {
  animation: none;
}

/* 半屏弹层里的按钮：弹层内容挂载时渐进出现 */
@keyframes sheetItemIn {
  from {
    opacity: 0;
    transform: translateY(5px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.sheet-body .tap-item {
  animation: sheetItemIn 0.3s cubic-bezier(0.22, 0.8, 0.3, 1) backwards;
}

.sheet-option {
  animation: sheetItemIn 0.3s cubic-bezier(0.22, 0.8, 0.3, 1) backwards;
}

.sheet-option:nth-child(2) { animation-delay: 0.02s; }
.sheet-option:nth-child(3) { animation-delay: 0.04s; }
.sheet-option:nth-child(4) { animation-delay: 0.06s; }
.sheet-option:nth-child(5) { animation-delay: 0.08s; }
.sheet-option:nth-child(6) { animation-delay: 0.1s; }
