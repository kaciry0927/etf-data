.empty {
  padding: 28px 20px;
  text-align: center;
  color: #78828f;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

.empty-icon {
  width: 64px;
  height: 64px;
  margin: 0 auto 10px;
  border-radius: 18px;
  background: #f2f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a3afc0;
  font-size: 24px;
  font-weight: 300;
}

.empty-title {
  font-size: 13px;
  font-weight: 600;
  color: #2c3645;
}

.empty-text {
  font-size: 10.5px;
  color: #78828f;
  line-height: 1.7;
  margin-top: 5px;
}

.empty-actions {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 12px;
}
