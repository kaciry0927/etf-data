.seg {
  display: flex;
  background: #eef1f6;
  border-radius: 8px;
  padding: 2px;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 11px;
  padding: 7px 0;
  border-radius: 6px;
  color: #78828f;
  white-space: nowrap;
  box-sizing: border-box;
  transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, transform 0.12s ease, opacity 0.12s ease;
}

.seg-item:active {
  transform: scale(0.96);
}

.seg-hover {
  opacity: 0.65;
}

.seg-item.active {
  background: #ffffff;
  color: #0f1620;
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(15, 22, 32, 0.09);
}

@keyframes segInA {
  from { opacity: 0; transform: translateY(3px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes segInB {
  from { opacity: 0; transform: translateY(3px); }
  to { opacity: 1; transform: translateY(0); }
}

.seg-anim-a .seg-item {
  animation: segInA 0.32s cubic-bezier(0.22, 0.8, 0.3, 1) backwards;
}

.seg-anim-b .seg-item {
  animation: segInB 0.32s cubic-bezier(0.22, 0.8, 0.3, 1) backwards;
}

.seg-anim-a .seg-item:nth-child(2),
.seg-anim-b .seg-item:nth-child(2) { animation-delay: 0.03s; }
.seg-anim-a .seg-item:nth-child(3),
.seg-anim-b .seg-item:nth-child(3) { animation-delay: 0.06s; }
.seg-anim-a .seg-item:nth-child(4),
.seg-anim-b .seg-item:nth-child(4) { animation-delay: 0.09s; }
