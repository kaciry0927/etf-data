<nav-bar title="我的" />

<view class="page tabpage {{pageAnim ? 'page-anim-' + pageAnim : ''}}">
  <!-- ① 数据状态头 -->
  <view class="profile-head">
    <view class="profile-row">
      <view class="profile-avatar">ETF</view>
      <view class="flex1">
        <view class="profile-name">国家队 ETF 监测台</view>
        <view class="profile-sub">研究工具 · 无需登录 · 数据本地缓存</view>
      </view>
      <view class="profile-badge">v{{version}}</view>
    </view>
    <view class="profile-stats">
      <view class="profile-stats-item">
        <view class="profile-stats-k">监控 ETF</view>
        <view class="profile-stats-v num">{{etfCount}}</view>
      </view>
      <view class="profile-stats-item">
        <view class="profile-stats-k">历史交易日</view>
        <view class="profile-stats-v num">{{dateCount}}</view>
      </view>
      <view class="profile-stats-item">
        <view class="profile-stats-k">数据源</view>
        <view class="profile-stats-v num">4</view>
      </view>
      <view class="profile-stats-item">
        <view class="profile-stats-k">最近更新</view>
        <view class="profile-stats-v num" style="font-size:13px;">{{updateTime}}</view>
      </view>
    </view>
  </view>

  <!-- ② 数据服务 -->
  <view class="section">
    <view class="section-head">
      <view class="section-title">数据服务</view>
    </view>
    <view class="cell-group">
      <view class="cell tap-item" bindtap="manualRefresh" hover-class="tap-feedback">
        <view class="cell-icon">↻</view>
        <view class="cell-main">
          <view class="cell-title">手动刷新数据</view>
          <view class="cell-sub">{{sourceText}} · 最近更新 {{updated}}</view>
        </view>
        <view class="cell-value">刷新<text class="chev">›</text></view>
      </view>
      <view class="cell tap-item" bindtap="openSources" hover-class="tap-feedback">
        <view class="cell-icon green">源</view>
        <view class="cell-main">
          <view class="cell-title">数据源与更新频率</view>
          <view class="cell-sub">份额 T+1 · 期货收盘后 · 龙虎榜实时</view>
        </view>
        <view class="cell-value"><text class="chev">›</text></view>
      </view>
      <view class="cell tap-item" bindtap="clearCache" hover-class="tap-feedback">
        <view class="cell-icon grey">清</view>
        <view class="cell-main">
          <view class="cell-title">清除本地缓存</view>
          <view class="cell-sub">当前 {{cacheText}} · 下次进入重新读取</view>
        </view>
        <view class="cell-value"><text class="chev">›</text></view>
      </view>
    </view>
    <view wx:if="{{statusNote}}" class="notice warn" style="margin-top:10px;">
      <view class="notice-icon">!</view>
      <view>{{statusNote}}</view>
    </view>
  </view>

  <!-- ③ 提醒与设置 -->
  <view class="section">
    <view class="section-head">
      <view class="section-title">提醒与设置</view>
    </view>
    <view class="cell-group">
      <view class="cell">
        <view class="cell-icon">铃</view>
        <view class="cell-main">
          <view class="cell-title">数据更新提醒</view>
          <view class="cell-sub">每日 23:00 ETF 份额更新后推送一次</view>
        </view>
        <view class="switch {{notif ? 'on' : ''}} tap-item" bindtap="toggleNotify" hover-class="tap-feedback">
          <view class="switch-knob"></view>
        </view>
      </view>
      <view class="cell tap-item" bindtap="openFeedback" hover-class="tap-feedback">
        <view class="cell-icon grey">言</view>
        <view class="cell-main">
          <view class="cell-title">意见反馈</view>
          <view class="cell-sub">数据异常 / 功能建议</view>
        </view>
        <view class="cell-value"><text class="chev">›</text></view>
      </view>
      <view class="cell tap-item" bindtap="openAbout" hover-class="tap-feedback">
        <view class="cell-icon grey">i</view>
        <view class="cell-main">
          <view class="cell-title">关于与免责声明</view>
          <view class="cell-sub">仅供研究参考，不构成投资建议</view>
        </view>
        <view class="cell-value">v{{version}}<text class="chev">›</text></view>
      </view>
    </view>
  </view>

  <!-- ④ 功能入口 -->
  <view class="section">
    <view class="section-head">
      <view class="section-title">功能入口</view>
    </view>
    <view class="cell-group">
      <view class="cell tap-item" bindtap="goBaseline" hover-class="tap-feedback">
        <view class="cell-icon amber">基</view>
        <view class="cell-main">
          <view class="cell-title">国家队持仓基准</view>
          <view class="cell-sub">2025 年报 · 6 家机构</view>
        </view>
        <view class="cell-value"><text class="chev">›</text></view>
      </view>
      <view class="cell tap-item" bindtap="goQihuo" hover-class="tap-feedback">
        <view class="cell-icon">龙</view>
        <view class="cell-main">
          <view class="cell-title">期指多空龙虎榜</view>
          <view class="cell-sub">中信期货 / 其他代客</view>
        </view>
        <view class="cell-value"><text class="chev">›</text></view>
      </view>
      <view class="cell tap-item" bindtap="goSnapshot" hover-class="tap-feedback">
        <view class="cell-icon green">表</view>
        <view class="cell-main">
          <view class="cell-title">最新快照</view>
          <view class="cell-sub">16 只 ETF 的 10 列明细</view>
        </view>
        <view class="cell-value"><text class="chev">›</text></view>
      </view>
      <view class="cell tap-item" bindtap="goFlow" hover-class="tap-feedback">
        <view class="cell-icon grey">势</view>
        <view class="cell-main">
          <view class="cell-title">净申赎走势</view>
          <view class="cell-sub">合计与单只 ETF</view>
        </view>
        <view class="cell-value"><text class="chev">›</text></view>
      </view>
    </view>
  </view>

  <!-- ⑤ 免责声明 -->
  <view class="section">
    <view class="notice">
      <view class="notice-icon">i</view>
      <view>本工具仅供研究参考，不构成任何投资建议。数据存在 T+1 延迟与估算误差，请以交易所及基金公司公告为准。</view>
    </view>
  </view>

  <view class="footer-note">
    <view>国家队 ETF 动向追踪 · 微信小程序 v{{version}}</view>
    <view>{{todayText}} · 数据口径以页面标注为准</view>
  </view>
</view>

<!-- 数据源半屏 -->
<sheet
  show="{{showSources}}"
  title="数据源与更新频率"
  hint="页面所有指标均由以下公开数据源计算，平均值 / 估算值均已在页面标注口径。"
  bindclose="closeSources"
>
  <view wx:for="{{sources}}" wx:key="key" class="source-item">
    <view class="cell-icon {{item.tone}}" style="width:30px;height:30px;flex-shrink:0;">源</view>
    <view class="flex1">
      <view class="source-name">{{item.name}}</view>
      <view class="source-desc">{{item.desc}}</view>
    </view>
    <view class="source-time">{{item.time}}</view>
  </view>
  <view class="chart-note" style="padding:10px 6px 0;">{{sourceNote}}</view>
</sheet>
