/* 期指多空页专属样式 */
.calendar-glyph {
  width: 20px;
  height: 20px;
  border-radius: 5px;
  background: #e9eef6;
  color: #2f6fdd;
  font-size: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.source-line {
  padding: 9px 14px 0;
  font-size: 9px;
  color: #9aa3af;
  line-height: 1.6;
}

.skeleton-note {
  font-size: 9px;
  color: #9aa3af;
  margin-top: 10px;
}

.rt-table {
  width: 100%;
}

.rt-table .td {
  flex: 1;
  padding: 8px 4px;
}

.rt-table .rt-c1 {
  flex: 1.3;
  text-align: left;
  padding-left: 12px;
}

.rt-table .rt-c5 {
  flex: 0 0 50px;
  padding-right: 10px;
}

.rt-prod {
  font-size: 10.5px;
  color: #0f1620;
}

.rt-prod-name {
  font-size: 9px;
  color: #9aa3af;
  margin-left: 2px;
}

.qihuo-note {
  padding: 14px 18px 0;
  font-size: 9px;
  color: #9aa3af;
  line-height: 1.7;
}
